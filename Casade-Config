local Config, Services, Recorder = ...
-- Cascade-compatible config storage. The linked Obsidian SaveManager expects
-- Obsidian's Library.Options/Toggles and cannot be attached to Cascade tabs.
local configFolder = "AOTR/Configs"
local autoloadFile = configFolder .. "/autoload.txt"
local configControls = {}
local pendingConfigValues = {}
local selectedConfigName
local savedConfigNames = {}

local valueComponentTypes = {
    Toggle = true,
    TextField = true,
    KeybindField = true,
    Slider = true,
    Stepper = true,
    RadioButtonGroup = true,
    PopUpButton = true,
    PullDownButton = true,
}

local function componentTitle(node)
    local ok, title = pcall(function()
        return node.Object and node.Object.Title
    end)
    if (not ok or type(title) ~= "string" or title == "") and type(node.Properties) == "table" then
        title = node.Properties.Title
    end
    if ok and type(title) == "string" and title ~= "" then
        return title
    end
    return nil
end

local function appendPath(path, segment)
    local result = table.clone(path)
    table.insert(result, segment)
    return result
end

local function collectAutomaticControls()
    local controls = {}
    local aliases = {}
    local aliasCollisions = {}

    if type(Recorder) ~= "table" or type(Recorder.Root) ~= "table" then
        return controls, aliases
    end

    local function visit(node, path, rowTitle)
        local nodePath = path
        local currentRowTitle = rowTitle

        if node.Type == "Tab" then
            nodePath = appendPath(path, "Tab:" .. tostring(componentTitle(node) or ""))
            currentRowTitle = nil
        elseif node.Type == "Section" or node.Type == "PageSection" then
            nodePath = appendPath(path, node.Type .. ":" .. tostring(componentTitle(node) or ""))
            currentRowTitle = nil
        elseif node.Type == "Row" then
            currentRowTitle = nil
            for _, child in ipairs(node.Children) do
                if child.Type == "TitleStack" then
                    currentRowTitle = componentTitle(child)
                    if currentRowTitle then
                        break
                    end
                end
            end
            if currentRowTitle then
                nodePath = appendPath(path, "Row:" .. currentRowTitle)
            end
        end

        local inConfigTab = table.find(nodePath, "Tab:Config") ~= nil
        if valueComponentTypes[node.Type] and node.Object and not inConfigTab then
            local key = table.concat(nodePath, "/") .. "/" .. node.Type
            controls[key] = node.Object

            if currentRowTitle then
                local alias = currentRowTitle:gsub("[^%w]", "")
                if alias ~= "" then
                    if aliases[alias] then
                        aliases[alias] = nil
                        aliasCollisions[alias] = true
                    elseif not aliasCollisions[alias] then
                        aliases[alias] = key
                    end
                end
            end
        end

        for _, child in ipairs(node.Children or {}) do
            visit(child, nodePath, currentRowTitle)
        end
    end

    visit(Recorder.Root, {}, nil)
    return controls, aliases
end

local function getConfigControls()
    local controls = collectAutomaticControls()
    for key, control in pairs(configControls) do
        controls[key] = control
    end
    return controls
end

local function registerConfigControl(key, control)
    configControls[key] = control

    local savedValue = pendingConfigValues[key]
    if savedValue ~= nil then
        pcall(function()
            control.Value = savedValue
        end)
    end
end

local function ensureConfigFolder()
    if type(makefolder) ~= "function" or type(isfolder) ~= "function" then
        return false, "Executor file APIs are unavailable"
    end

    for _, folder in ipairs({ "AOTR", configFolder }) do
        if not isfolder(folder) then
            makefolder(folder)
        end
    end

    return true
end

local function configFilePath(name)
    if type(name) ~= "string" or not name:match("^[%w _%-]+$") then
        return nil
    end

    return configFolder .. "/" .. name .. ".json"
end

local configForm = Config:Form()
configForm:PageSection({
    Title = "Configuration Manager",
    Subtitle = "Save your settings and restore them later.",
})

local nameRow = configForm:Row()
nameRow:Left():TitleStack({
    Title = "Configuration name",
    Subtitle = "The name used for the saved file.",
})
local configNameField = nameRow:Right():TextField({
    Value = "default",
    Placeholder = "Configuration name",
})

local configRow = configForm:Row()
configRow:Left():TitleStack({
    Title = "Saved configurations",
    Subtitle = "Select a configuration to load, delete, or use at startup.",
})
local configList = configRow:Right():PullDownButton({
    Label = "Select configuration",
    Options = {},
    ValueChanged = function(self, selectedIndex)
        selectedConfigName = self.Options[selectedIndex]
        if selectedConfigName then
            configNameField.Value = selectedConfigName
            self.Label = selectedConfigName
        end
    end,
})

local function refreshConfigList()
    savedConfigNames = {}

    if type(listfiles) == "function" and type(isfile) == "function" then
        local ok, files = pcall(listfiles, configFolder)
        if ok and type(files) == "table" then
            for _, filePath in ipairs(files) do
                if type(filePath) == "string" then
                    local name = filePath:match("([^/\\]+)%.json$")
                    if name then
                        table.insert(savedConfigNames, name)
                    end
                end
            end
        end
    end

    table.sort(savedConfigNames)

    while #(configList.Options or {}) > 0 do
        configList:Remove(#configList.Options)
    end

    for _, name in ipairs(savedConfigNames) do
        configList:Option(name)
    end

    selectedConfigName = nil
    configList.Label = "Select configuration"
end

local function readConfig(name)
    local path = configFilePath(name)
    if not path then
        return false, "Config name may only contain letters, numbers, spaces, _ and -"
    end
    if type(readfile) ~= "function" or type(isfile) ~= "function" or not isfile(path) then
        return false, "Config file was not found"
    end

    local ok, content = pcall(readfile, path)
    if not ok then
        return false, "Could not read config file"
    end

    local decoded, data = pcall(function()
        return Services.HttpService:JSONDecode(content)
    end)
    if not decoded or type(data) ~= "table" then
        return false, "Config file contains invalid JSON"
    end

    pendingConfigValues = data
    local controls, aliases = collectAutomaticControls()
    for key, control in pairs(configControls) do
        controls[key] = control
    end
    local matchedCount = 0
    for key, control in pairs(controls) do
        local value = data[key]
        if value == nil then
            for alias, aliasedKey in pairs(aliases) do
                if aliasedKey == key then
                    value = data[alias]
                    break
                end
            end
        end
        if value ~= nil then
            local applied = pcall(function()
                control.Value = value
            end)
            if applied then
                matchedCount += 1
            end
        end
    end

    if matchedCount == 0 then
        return false, "No matching saved controls were found; save this config again with the updated script"
    end

    return true, tostring(matchedCount) .. " setting(s) loaded"
end

local function saveConfig(name)
    local path = configFilePath(name)
    if not path then
        return false, "Config name may only contain letters, numbers, spaces, _ and -"
    end
    if type(writefile) ~= "function" then
        return false, "Executor writefile API is unavailable"
    end

    local folderCallSucceeded, folderCreated, folderError = pcall(ensureConfigFolder)
    if not folderCallSucceeded or not folderCreated then
        return false, tostring(folderError)
    end

    local values = {}
    for key, control in pairs(getConfigControls()) do
        local ok, value = pcall(function()
            return control.Value
        end)
        if ok and (type(value) == "string" or type(value) == "number" or type(value) == "boolean") then
            values[key] = value
        end
    end

    local encoded, contents = pcall(function()
        return Services.HttpService:JSONEncode(values)
    end)
    if not encoded then
        return false, "Could not encode config"
    end

    local wrote, writeError = pcall(writefile, path, contents)
    if not wrote then
        return false, tostring(writeError)
    end

    return true
end

local statusLabel = configForm:Row():Left():Label({
    Text = "Ready",
})

local function reportConfigResult(action, success, detail)
    local message = success and (action .. " completed" .. (detail and (": " .. tostring(detail)) or ""))
        or (action .. " failed: " .. tostring(detail))
    statusLabel.Text = message
    print("[AOTR Config] " .. message)
    if not success then
        warn("[AOTR Config] " .. tostring(detail))
    end
end

local function addConfigButton(row, label, callback)
    row:Right():Button({
        Label = label,
        Pushed = callback,
    })
end

local saveLoadRow = configForm:Row()
saveLoadRow:Left():TitleStack({
    Title = "Save or load",
    Subtitle = "Save the current values or load the selected configuration.",
})
addConfigButton(saveLoadRow, "Save", function()
    local name = configNameField.Value
    local success, detail = saveConfig(name)
    if success then
        refreshConfigList()
    end
    reportConfigResult("Save", success, detail)
end)

addConfigButton(saveLoadRow, "Load", function()
    local name = selectedConfigName or configNameField.Value
    local success, detail = readConfig(name)
    reportConfigResult("Load", success, detail)
end)

local manageRow = configForm:Row()
manageRow:Left():TitleStack({
    Title = "Manage configurations",
    Subtitle = "Refresh the list or delete the selected configuration.",
})
addConfigButton(manageRow, "Delete", function()
    local name = selectedConfigName or configNameField.Value
    local path = configFilePath(name)
    if not path then
        reportConfigResult("Delete", false, "Invalid configuration name")
        return
    end
    if type(delfile) ~= "function" or type(isfile) ~= "function" or not isfile(path) then
        reportConfigResult("Delete", false, "Configuration file not found")
        return
    end

    local success, detail = pcall(delfile, path)
    if success then
        refreshConfigList()
    end
    reportConfigResult("Delete", success, detail)
end)

addConfigButton(manageRow, "Refresh", refreshConfigList)

local autoloadRow = configForm:Row()
local autoloadTitleStack = autoloadRow:Left():TitleStack({
    Title = "Startup configuration",
    Subtitle = "No startup configuration set.",
})
local function updateAutoloadDescription(name)
    autoloadTitleStack.Subtitle = name and ("Autoload configuration: " .. name) or "No startup configuration set."
end
addConfigButton(autoloadRow, "Set autoload", function()
    local name = selectedConfigName or configNameField.Value
    if not configFilePath(name) then
        reportConfigResult("Set autoload", false, "Invalid configuration name")
        return
    end
    if type(writefile) ~= "function" then
        reportConfigResult("Set autoload", false, "Executor writefile API is unavailable")
        return
    end

    local folderCallSucceeded, folderCreated, folderError = pcall(ensureConfigFolder)
    if not folderCallSucceeded or not folderCreated then
        reportConfigResult("Set autoload", false, folderError)
        return
    end

    local success, detail = pcall(writefile, autoloadFile, name)
    if success then
        updateAutoloadDescription(name)
    end
    reportConfigResult("Autoload set to " .. name, success, detail)
end)

addConfigButton(autoloadRow, "Reset", function()
    if type(delfile) ~= "function" or type(isfile) ~= "function" or not isfile(autoloadFile) then
        reportConfigResult("Reset autoload", false, "No autoload configuration is set")
        return
    end

    local success, detail = pcall(delfile, autoloadFile)
    if success then
        updateAutoloadDescription(nil)
    end
    reportConfigResult("Reset autoload", success, detail)
end)

if pcall(ensureConfigFolder) then
    refreshConfigList()

    if type(isfile) == "function" and type(readfile) == "function" and isfile(autoloadFile) then
        local readOk, name = pcall(readfile, autoloadFile)
        if readOk and type(name) == "string" and name ~= "" then
            updateAutoloadDescription(name)
            local loadOk, loadError = readConfig(name)
            reportConfigResult("Autoloaded " .. name, loadOk, loadError)
        end
    end
end
return {
    Register = registerConfigControl,
}
